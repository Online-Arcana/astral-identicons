{
  "name": "astrological-identicon",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "identicon": "bun run src/cli.ts",
    "palette:tune": "bun run scripts/tune-palette.ts",
    "glyphs:generate": "python3 scripts/generate-planet-glyphs.py",
    "glyphs:check": "python3 scripts/generate-planet-glyphs.py --check",
    "build:pages": "bun run scripts/build-pages.ts",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
